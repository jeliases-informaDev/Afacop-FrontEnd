# Radar 360 Frontend - variable publica incluida dentro del bundle.
# No coloque contrasenas, tokens ni secretos en variables VITE_*.
# Solo para desarrollo: los builds de produccion usan siempre https://api-miradar360.sulotec.com (ver AuthContext).
# URL HTTPS exacta del backend, sin slash final.
VITE_API_URL=https://api-miradar360.sulotec.com
