{
	"name": "@atlaskit/select",
	"version": "22.6.4",
	"description": "Select allows users to make a single selection or multiple selections from a list of options.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Select",
			"category": "Forms and input"
		}
	},
	"dependencies": {
		"@atlaskit/analytics-next": "^12.3.0",
		"@atlaskit/ds-lib": "^8.0.0",
		"@atlaskit/icon": "^37.3.0",
		"@atlaskit/layering": "^5.0.0",
		"@atlaskit/platform-feature-flags": "^2.1.0",
		"@atlaskit/popper": "^9.0.0",
		"@atlaskit/primitives": "^22.2.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/react-select": "^4.7.0",
		"@atlaskit/theme": "^27.0.0",
		"@atlaskit/tokens": "^16.3.0",
		"@atlaskit/top-layer": "^3.1.0",
		"@atlaskit/visually-hidden": "^4.2.0",
		"@babel/runtime": "^7.0.0",
		"@compiled/react": "^1.0.0",
		"@popperjs/core": "^2.11.8",
		"bind-event-listener": "^3.0.0",
		"react-focus-lock": "^2.9.5",
		"react-popper": "^2.3.0",
		"shallow-equal": "^3.1.0"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/button": "^25.0.0",
		"@atlaskit/checkbox": "^19.0.0",
		"@atlaskit/docs": "^12.1.0",
		"@atlaskit/drawer": "^13.4.0",
		"@atlaskit/form": "^16.1.0",
		"@atlaskit/link": "^5.0.0",
		"@atlaskit/logo": "^21.4.0",
		"@atlaskit/modal-dialog": "^16.3.0",
		"@atlaskit/radio": "^9.1.0",
		"@atlaskit/section-message": "^10.0.0",
		"@atlassian/feature-flags-test-utils": "^1.2.0",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/testing-library": "^0.11.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.4.3",
		"ast-types": "^0.13.3",
		"jest-in-case": "^1.0.2",
		"jscodeshift": "^17.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-select-event": "^5.5.0",
		"tiny-invariant": "^1.2.0"
	},
	"techstack": {
		"@repo/internal": {
			"dom-events": "use-bind-event-listener",
			"design-tokens": [
				"color",
				"spacing"
			],
			"deprecation": "no-deprecated-imports",
			"styling": [
				"static",
				"compiled"
			]
		}
	},
	"platform-feature-flags": {
		"platform-component-visual-refresh": {
			"type": "boolean"
		},
		"platform-dst-shape-theme-default": {
			"type": "boolean"
		},
		"platform-dst-top-layer": {
			"type": "boolean"
		},
		"platform-dst-popper-consolidation": {
			"type": "boolean",
			"referenceOnly": true
		},
		"platform-dst-lozenge-tag-badge-visual-uplifts": {
			"type": "boolean"
		},
		"platform_dst_select_dropdown_voice_control": {
			"type": "boolean",
			"referenceOnly": true
		},
		"platform_dst_select_disabled_a11y_fix": {
			"type": "boolean",
			"referenceOnly": true
		},
		"platform-dst-motion-uplift-list-item": {
			"type": "boolean"
		}
	},
	"homepage": "https://atlassian.design/components/select/"
}
