{
	"name": "@atlaskit/tag",
	"version": "15.4.5",
	"description": "A tag labels UI objects for quick recognition and navigation.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"homepage": "https://atlassian.design/components/tag/",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Tag",
			"category": "Labels",
			"status": {
				"type": "ready-for-ga",
				"description": "The new tag is stable and ready for adoption. Visual updates are currently behind the `platform-dst-lozenge-tag-badge-visual-uplifts` feature flag."
			},
			"subPages": [
				{
					"title": "Tag",
					"id": "tag",
					"status": {
						"type": "intent-to-deprecate",
						"description": "We're planning to deprecate this component. If you have the Atlassian feature flag integration, use the new tag. Otherwise, the old experience will switch to the new one automatically when we clean up the feature flag."
					}
				},
				{
					"title": "AvatarTag",
					"id": "avatar-tag"
				}
			]
		}
	},
	"dependencies": {
		"@atlaskit/analytics-next": "^12.3.0",
		"@atlaskit/avatar": "^26.4.0",
		"@atlaskit/css": "^1.0.0",
		"@atlaskit/ds-lib": "^8.0.0",
		"@atlaskit/icon": "^37.3.0",
		"@atlaskit/link": "^5.0.0",
		"@atlaskit/lozenge": "^15.0.0",
		"@atlaskit/motion": "^8.0.0",
		"@atlaskit/platform-feature-flags": "^2.1.0",
		"@atlaskit/primitives": "^22.2.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/spinner": "^20.1.0",
		"@atlaskit/teams-avatar": "^4.1.0",
		"@atlaskit/tokens": "^16.3.0",
		"@babel/runtime": "^7.0.0",
		"@compiled/react": "^1.0.0"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/button": "^25.0.0",
		"@atlaskit/code": "^18.2.0",
		"@atlaskit/docs": "^12.1.0",
		"@atlaskit/section-message": "^10.0.0",
		"@atlaskit/tag-group": "^13.1.0",
		"@atlassian/feature-flags-test-utils": "^1.2.0",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/testing-library": "^0.11.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.4.3",
		"raf-stub": "^2.0.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"techstack": {
		"@atlassian/frontend": {
			"import-structure": "atlassian-conventions"
		},
		"@repo/internal": {
			"dom-events": "use-bind-event-listener",
			"design-system": "v1",
			"ui-components": "lite-mode",
			"analytics": "analytics-next",
			"design-tokens": [
				"color",
				"spacing"
			],
			"deprecation": "no-deprecated-imports",
			"styling": [
				"emotion",
				"static"
			]
		}
	},
	"platform-feature-flags": {
		"platform-dst-lozenge-tag-badge-visual-uplifts": {
			"type": "boolean"
		},
		"parent-field-switcher-missing-info-image-text": {
			"type": "boolean",
			"referenceOnly": true
		}
	}
}
