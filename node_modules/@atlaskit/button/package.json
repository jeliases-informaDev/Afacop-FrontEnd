{
	"name": "@atlaskit/button",
	"version": "25.0.2",
	"description": "A button triggers an event or action. They let users know what will happen next.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Button",
			"category": "Forms and input",
			"subPages": [
				{
					"title": "Icon button",
					"id": "icon-button",
					"sortKey": 1
				},
				{
					"title": "Link button",
					"id": "link-button",
					"sortKey": 2
				},
				{
					"title": "Link icon button",
					"id": "link-icon-button",
					"sortKey": 3
				},
				{
					"title": "Split button",
					"id": "split-button",
					"sortKey": 4
				},
				{
					"title": "Button group",
					"id": "button-group",
					"sortKey": 5
				},
				{
					"title": "Button (legacy)",
					"id": "button-legacy",
					"status": {
						"type": "intent-to-deprecate",
						"description": "Legacy buttons will soon be deprecated. Please use the new [button](/components/button), [icon button](/components/button/icon-button), [link button](/components/button/link-button), or [link icon button](/components/button/link-icon-button). Migrate from legacy buttons using our codemod.",
						"actions": [
							{
								"text": "View the migration guide",
								"href": "/components/button/button-legacy/migration-guide"
							}
						]
					},
					"sortKey": 6
				}
			]
		}
	},
	"dependencies": {
		"@atlaskit/analytics-next": "^12.3.0",
		"@atlaskit/css": "^1.0.0",
		"@atlaskit/ds-lib": "^8.0.0",
		"@atlaskit/focus-ring": "^5.0.0",
		"@atlaskit/icon": "^37.3.0",
		"@atlaskit/interaction-context": "^4.0.0",
		"@atlaskit/platform-feature-flags": "^2.1.0",
		"@atlaskit/primitives": "^22.2.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/spinner": "^20.1.0",
		"@atlaskit/theme": "^27.0.0",
		"@atlaskit/tokens": "^16.3.0",
		"@atlaskit/tooltip": "^24.0.0",
		"@atlaskit/visually-hidden": "^4.2.0",
		"@babel/runtime": "^7.0.0",
		"@compiled/react": "^1.0.0",
		"@emotion/react": "^11.7.1"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/app-provider": "^5.2.0",
		"@atlaskit/checkbox": "^19.0.0",
		"@atlaskit/docs": "^12.1.0",
		"@atlaskit/dropdown-menu": "^17.2.0",
		"@atlaskit/form": "^16.1.0",
		"@atlaskit/heading": "^7.0.0",
		"@atlaskit/link": "^5.0.0",
		"@atlaskit/logo": "^21.4.0",
		"@atlaskit/modal-dialog": "^16.3.0",
		"@atlaskit/section-message": "^10.0.0",
		"@atlaskit/select": "^22.6.0",
		"@atlaskit/toggle": "^17.1.0",
		"@atlassian/feature-flags-test-utils": "^1.2.0",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.4.3",
		"ast-types": "^0.13.3",
		"jscodeshift": "^17.0.0",
		"lodash": "^4.17.21",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"homepage": "https://atlassian.design/components/button/",
	"platform-feature-flags": {
		"platform_dst_button_chevron_sizing": {
			"type": "boolean"
		},
		"platform-dst-shape-theme-default": {
			"type": "boolean"
		},
		"platform-dst_fix_not_focusable_loading_button": {
			"type": "boolean"
		},
		"platform-dst-motion-uplift-button": {
			"type": "boolean"
		},
		"platform-dst-legacy-button-anchor-text-color": {
			"type": "boolean"
		}
	}
}
