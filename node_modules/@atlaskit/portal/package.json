{
	"name": "@atlaskit/portal",
	"version": "6.2.1",
	"description": "A wrapper for rendering components in React portals.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Portal",
			"category": "Libraries"
		}
	},
	"dependencies": {
		"@atlaskit/app-provider": "^5.2.0",
		"@atlaskit/platform-feature-flags": "^2.1.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/theme": "^27.0.0",
		"@babel/runtime": "^7.0.0"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/button": "^25.0.0",
		"@atlaskit/code": "^18.2.0",
		"@atlaskit/css": "^1.0.0",
		"@atlaskit/docs": "^12.1.0",
		"@atlaskit/flag": "^18.2.0",
		"@atlaskit/icon": "^37.3.0",
		"@atlaskit/inline-dialog": "^19.2.0",
		"@atlaskit/link": "^5.0.0",
		"@atlaskit/modal-dialog": "^16.3.0",
		"@atlaskit/onboarding": "^15.1.0",
		"@atlaskit/primitives": "^22.2.0",
		"@atlaskit/section-message": "^10.0.0",
		"@atlaskit/tokens": "^16.3.0",
		"@atlaskit/tooltip": "^24.0.0",
		"@atlassian/feature-flags-test-utils": "^1.2.0",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@compiled/react": "^1.0.0",
		"@testing-library/react": "^16.3.0",
		"bind-event-listener": "^3.0.0",
		"raf-stub": "^2.0.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"keywords": [
		"atlaskit",
		"react",
		"ui"
	],
	"techstack": {
		"@atlassian/frontend": {
			"import-structure": "atlassian-conventions"
		},
		"@repo/internal": {
			"dom-events": "use-bind-event-listener",
			"design-system": "v1",
			"ui-components": "lite-mode",
			"analytics": "analytics-next",
			"design-tokens": [
				"color",
				"spacing"
			],
			"deprecation": "no-deprecated-imports",
			"styling": [
				"static",
				"compiled"
			]
		}
	},
	"homepage": "https://atlassian.design/components/portal/",
	"platform-feature-flags": {
		"platform_design_system_team_portal_logic_r18_fix": {
			"type": "boolean"
		},
		"import_into_jsm_in_template_gallery_killswitch": {
			"type": "boolean"
		}
	}
}
